{
	# Railway termina el TLS en su borde y envía HTTP al contenedor.
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# --- URLs limpias: /pagina.html → /pagina (301) ---
	@index path /index.html
	redir @index / 301
	@html path_regexp html ^/(.+)\.html$
	redir @html /{re.html.1} 301

	# --- Cabeceras de seguridad y caché ---
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	header /static/* Cache-Control "public, max-age=86400"
	@paginas not path /static/*
	header @paginas Cache-Control "public, max-age=0, must-revalidate"

	# /lechona-en-cumaral → lechona-en-cumaral.html
	try_files {path} {path}.html {path}/index.html

	# --- Página 404 propia ---
	handle_errors {
		@404 expression {http.error.status_code} == 404
		handle @404 {
			rewrite * /404.html
			file_server
		}
	}

	file_server
}
